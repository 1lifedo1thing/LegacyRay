    { "Version %@ (%@)", "Версия %@ (%@)", "版本 %@（%@）" },
    { "About", "О программе", "关于" },
    { "A full-device VLESS, Trojan, Shadowsocks, SOCKS and AmneziaWG client for jailbroken iOS 4 to 7, with a receiver for a face.", "Клиент VLESS, Trojan, Shadowsocks, SOCKS и AmneziaWG для всего устройства на iOS 4–7 с джейлбрейком — с лицевой панелью радиоприёмника.", "适用于越狱 iOS 4–7 的全设备 VLESS、Trojan、Shadowsocks、SOCKS 和 AmneziaWG 客户端，外观是一台收音机。" },
    { "Common questions", "Частые вопросы", "常见问题" },
    { "Credits", "Благодарности", "致谢" },
    { "Project on GitHub", "Проект на GitHub", "GitHub 项目" },
